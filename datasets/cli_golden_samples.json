        "resolved_ip": "93.184.216.34",
        "dns_error": null,
        "tls": {
          "tls_version": "TLSv1.3",
          "cert_expiry_days": 89,
          "cert_is_expired": false,
          "cert_chain_complete": true,
          "handshake_time_ms": 45.2
        },
        "overall_status": "valid",
        "classification": "VALID_TLS"
      },
      "expected": {
        "classification": "VALID_TLS",
