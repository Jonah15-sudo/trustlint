{
  "_metadata": {
    "description": "Policy expectations for SPL decision validation on mixed TLS probe results",
    "purpose": "Measure SPL policy conformance — not ground truth, but expected operational risk categories",
    "policy_categories": {
      "ACCEPTABLE_TLS": "TLS connection succeeded with valid certificate chain. Acceptable for general use.",
      "SECURITY_RISK": "TLS failure indicates a security concern (expired, self-signed, wrong-host, untrusted, incomplete chain). Immediate attention recommended.",
      "AVAILABILITY_RISK": "Domain was unreachable due to DNS or connection failure. Service impact, not necessarily a TLS security issue.",
      "AMBIGUOUS_FAILURE": "Failure mode could be security or availability. Requires human investigation.",
      "UNKNOWN": "Classification could not be determined."
    }
  },
